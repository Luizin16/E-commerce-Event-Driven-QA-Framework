{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PedidoSchema",
  "type": "object",
  "properties": {
    "pedidoId": {
      "type": "string"
    },
    "valor": {
      "type": "number",
      "minimum": 0.01
    },
    "status": {
      "type": "string",
      "enum": ["CRIADO", "PAGO", "CANCELADO"]
    }
  },
  "required": ["pedidoId", "valor", "status"]
}